        "properties": {
          "section_key": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "source_ref_count": {
      "type": "integer"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "type": "string"
    },
    "stub_reason": {
      "type": "string"
    },
    "timeout_ms": {
      "type": "integer"
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workflow_pack_family": {
      "type": "string"
    }
