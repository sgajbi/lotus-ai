{
  "task_id": "provider.operations.v1",
  "fixture_family": "provider_operations_examples",
  "cases": [
    {
      "case_id": "quota_exceeded_requires_structured_rejection",
      "summary": "Quota-blocked live-provider execution should reject explicitly and preserve the blocking category.",
      "input": {
        "task_id": "explain.v1",
        "configured_mode": "openai",
        "quota_scope": "task",
        "request_limit": 1
      },
      "expected": {
        "failure_category": "QUOTA_EXCEEDED",
        "must_emit_structured_rejection": true,
        "expected_outcome": "QUOTA_BLOCK"
      }
    },
    {
      "case_id": "hard_budget_block_requires_structured_rejection",
      "summary": "Hard-budget overflow should reject explicitly and preserve the blocking category.",
      "input": {
        "task_id": "explain.v1",
        "configured_mode": "openai",
        "hard_budget_usd": 1.0,
        "rate_card": { "input_cost_per_1k_tokens": 0.01, "output_cost_per_1k_tokens": 0.03 },
        "tracked_spend_usd": 1.0
      },
      "expected": {
        "failure_category": "BUDGET_EXCEEDED",
        "must_emit_structured_rejection": true,
        "expected_outcome": "BUDGET_BLOCK"
      }
    },
    {
      "case_id": "persisted_budget_posture_survives_runtime_restart",
      "summary": "Tracked spend should remain authoritative after a service restart when the durable provider-operations store is enabled.",
      "input": {
        "task_id": "explain.v1",
        "configured_mode": "openai",
        "provider_operations_store_mode": "sqlalchemy",
        "recorded_spend_usd": 0.75,
        "hard_budget_usd": 1.0,
        "rate_card": { "input_cost_per_1k_tokens": 0.01, "output_cost_per_1k_tokens": 0.03 }
      },
      "expected": {
        "budget_state": "SOFT_LIMIT_REACHED",
        "must_survive_restart": true,
        "expected_outcome": "DURABLE_BUDGET_POSTURE"
      }
    }
  ]
}
