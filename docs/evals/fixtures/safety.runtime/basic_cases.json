          "raw_context": {
            "account_number": "12345"
          }
        }
      },
      "expected": {
        "disposition": "BLOCKED",
        "runtime_redaction_active": true
      }
    },
    {
      "case_id": "runtime_safety_degrades_when_preview_cannot_be_preserved",
      "summary": "Runtime safety degrades to a generic fallback when the original preview cannot be preserved safely.",
