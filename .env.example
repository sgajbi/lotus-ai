APP_ENV=local
LOTUS_AI_LOG_LEVEL=INFO
ROUNDING_POLICY_VERSION=v1
LOTUS_AI_AUDIT_STORE_MODE=sqlalchemy
LOTUS_AI_PROMPT_STORE_MODE=sqlalchemy
LOTUS_AI_RETRIEVAL_STORE_MODE=sqlalchemy
LOTUS_AI_ACCESS_CONTROL_STORE_MODE=sqlalchemy
LOTUS_AI_PROVIDER_OPERATIONS_STORE_MODE=sqlalchemy
LOTUS_AI_MODEL_CATALOGUE_STORE_MODE=sqlalchemy
LOTUS_AI_KILL_SWITCH_STORE_MODE=sqlalchemy
LOTUS_AI_RATE_CARD_STORE_MODE=sqlalchemy
LOTUS_AI_ASYNC_RUNTIME_STORE_MODE=sqlalchemy
LOTUS_AI_EVALUATION_RUNTIME_STORE_MODE=sqlalchemy
LOTUS_AI_ARTIFACT_STORE_MODE=sqlalchemy
LOTUS_AI_ARTIFACT_OBJECT_STORE_MODE=filesystem
LOTUS_AI_ARTIFACT_OBJECT_STORE_ROOT=/data/object-store
LOTUS_AI_SECRET_SOURCE_MODE=local_or_unspecified
LOTUS_AI_STARTUP_READINESS_POLICY=warn
LOTUS_AI_READINESS_PROBE_POLICY=observe
LOTUS_AI_LOCAL_HEADER_CALLER_IDENTITY_ENABLED=true
LOTUS_AI_DATABASE_URL=postgresql+psycopg://lotus:lotus@postgres:5432/lotus_ai
LOTUS_AI_RETRIEVAL_MODE=disabled
LOTUS_AI_EMBEDDING_PROVIDER_MODE=disabled
LOTUS_AI_LIVE_EMBEDDING_PROVIDER_ID=
LOTUS_AI_LIVE_EMBEDDING_MODEL_ID=
LOTUS_AI_LIVE_EMBEDDING_PROVIDER_API_KEY=
LOTUS_AI_LIVE_TEXT_MODEL_VERSION=
LOTUS_AI_LIVE_TEXT_TEMPERATURE=0.0
LOTUS_AI_REDACTION_MODE=enforce
# Optional sampling bounds; leave unset (commented) to omit from provider calls.
# LOTUS_AI_LIVE_TEXT_TOP_P=1.0
# LOTUS_AI_LIVE_TEXT_SEED=1
LOTUS_AI_WORKFLOW_RUN_ATTESTATION_KEY_ID=
LOTUS_AI_WORKFLOW_RUN_ATTESTATION_ROTATION_EPOCH=1
LOTUS_AI_WORKFLOW_RUN_ATTESTATION_PRIVATE_KEY_BASE64URL=
LOTUS_AI_WORKFLOW_RUN_ATTESTATION_KEY_NOT_BEFORE_UTC=
LOTUS_AI_WORKFLOW_RUN_ATTESTATION_KEY_NOT_AFTER_UTC=
LOTUS_AI_WORKFLOW_RUN_ATTESTATION_ROTATED_PUBLIC_KEYS_JSON=[]
LOTUS_AI_WORKFLOW_RUN_MODEL_RISK_INVENTORY_JSON=[]
LOTUS_AI_WORKFLOW_RUN_ATTESTATION_TTL_SECONDS=300
LOTUS_AI_ASYNC_CUTOVER_STATE=dedicated_workers_active
LOTUS_AI_ASYNC_QUEUE_BACKEND_MODE=redis
LOTUS_AI_ASYNC_QUEUE_REDIS_URL=redis://redis:6379/0
